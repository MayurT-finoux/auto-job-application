# On Vercel set these in Project -> Settings -> Environment Variables.
# Locally, copy this file to .env.

# Gmail account used to send applications (needs an App Password:
# Google Account -> Security -> 2-Step Verification -> App passwords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Dashboard login password (required on Vercel)
DASHBOARD_PASSWORD=choose-a-strong-password

# Vercel sends this to /api/run as "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=

# Neon Postgres connection string. Added automatically by the Neon integration on Vercel.
# Leave empty locally to use data/jobbot.db (SQLite).
DATABASE_URL=

# Optional free job APIs (leave blank to disable)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
