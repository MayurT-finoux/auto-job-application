{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "{dashboard.py,config.yaml,job_profile.yaml,jobbot/**,templates/**}"
    }
  },
  "schedules": {
    "job-applier": {
      "schedule": "*/15 * * * *",
      "path": "/api/run",
      "requestMethod": "GET"
    }
  }
}
